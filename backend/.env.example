REED_RUNTIME_MODE=local
REED_DATABASE_PATH=./data/reed.db
REED_BIND_HOST=127.0.0.1
REED_BIND_PORT=8000
REED_ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000
REED_LOCAL_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
REED_PROVIDER_ALLOWED_HOSTS=
REED_VALIDATE_RSS_CATALOG_ON_STARTUP=false

# Hosted deployments must set an exact non-empty reader origin allowlist.
# REED_HOSTED_ALLOWED_ORIGINS=https://example.github.io
# Generic OpenAI-compatible endpoints require their exact HTTPS hostname.
# REED_PROVIDER_ALLOWED_HOSTS=api.compatible-provider.example
